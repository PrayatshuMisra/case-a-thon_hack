# Local backend server
PORT=3100
CALL_RING_DEFAULT_CHANNEL=local-rn

# Supabase (read context from all configured tables)
SUPABASE_URL=
SUPABASE_KEY=

# Preferred LLM provider: xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# STT provider (Groq Whisper API)
# If missing, server also tries VITE_GROQ_API_KEY from sibling case-a-thon env.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional fallback LLM model when only Groq key exists
GROQ_LLM_MODEL=llama-3.3-70b-versatile
